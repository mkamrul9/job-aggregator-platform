# ==============================================================================
# frontend-next (React / Next.js Candidate App) — Environment Example
# Copy to .env.local for local frontend development.
# ==============================================================================

# --- Elasticsearch Node (Server-Side Route Handler) ---
# Direct Elasticsearch connection used by server-side /api/jobs route
# Standalone local: http://localhost:9200
# Docker Compose:   http://elasticsearch:9200
ES_NODE=http://localhost:9200

# --- Firebase Client SDK Configuration (Public Keys) ---
# For local dev without live Firebase, use the emulator URL below
NEXT_PUBLIC_FIREBASE_API_KEY=mock_api_key_placeholder
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=seekers-dev.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=seekers-dev
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=seekers-dev.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:abcdef123456

# --- Local Identity Emulator ---
# Set this to use local Firebase Auth emulator instead of Google cloud authentication
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=http://localhost:9099

# --- Backend API Gateway Base URL ---
# In development, leave blank or relative so calls route through local Nginx reverse proxy
NEXT_PUBLIC_API_BASE_URL=
