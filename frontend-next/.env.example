# Copy to .env.local; public Firebase values must belong to your project.
# Client emulator/API-base switches are not implemented yet.
INGESTION_API_URL=http://localhost:5000
NEXT_PUBLIC_FIREBASE_API_KEY=replace-with-your-public-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=replace-with-your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=replace-with-your-project-id
