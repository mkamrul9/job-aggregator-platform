# ==============================================================================
# service-scraper (Go Job Collection Engine) — Environment Configuration Example
# Copy to .env for local standalone or container runs.
# ==============================================================================

# --- Kafka Event Broker ---
# Required for integrated mode; in standalone fixture demo mode, output can be routed to stdout/file.
# Standalone local: localhost:9092
# Docker Compose:   kafka:9092
KAFKA_BROKER=localhost:9092

# --- Kafka Topics ---
KAFKA_JOB_TOPIC=jobs.new

# --- Scraper Execution Settings ---
# Concurrency limit for scraping goroutines (default: 3)
SCRAPER_CONCURRENCY=3

# Headless mode for Playwright browser automation (true in production/Docker, false for local visual debugging)
HEADLESS=true

# Request timeout in milliseconds
SCRAPER_TIMEOUT_MS=30000
