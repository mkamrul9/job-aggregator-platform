# ==============================================================================
# frontend-admin (Angular Operations Dashboard) — Environment Example
# Copy to .env for local Angular development.
# ==============================================================================

# --- Live Feed WebSocket Gateway ---
# Address of the notification service Socket.io instance
# Standalone local: http://localhost:4000
# Integrated Gateway: http://localhost/socket.io
NG_APP_SOCKET_URL=http://localhost:4000

# --- REST API Base URL ---
NG_APP_API_URL=http://localhost:80

# --- Synthetic Demo Mode ---
# When enabled in feature phase P12, renders synthetic event feed for standalone recruiter evaluation
NG_APP_DEMO_MODE=false
