# ==============================================================================
# service-ingestion (Node.js Job Ingestion & Search API) — Environment Example
# Copy to .env for local standalone or container runs.
# ==============================================================================

# --- HTTP Server ---
PORT=5000

# --- Kafka Event Broker ---
# Required for real streaming ingestion; standalone demo mode will support fixture replay.
# Standalone local: localhost:9092
# Docker Compose:   kafka:9092
KAFKA_BROKER=localhost:9092
KAFKA_TOPIC=jobs.new
KAFKA_GROUP_ID=mongo-ingestion-group

# --- MongoDB Primary Document Store ---
# Standalone local: mongodb://localhost:27017
# Docker Compose:   mongodb://job-mongo:27017
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=job_platform

# --- Elasticsearch Search Projection ---
# Standalone local: http://localhost:9200
# Docker Compose:   http://elasticsearch:9200
ES_NODE=http://localhost:9200
ES_INDEX_NAME=jobs_index

# --- CORS & Client Security ---
CORS_ORIGINS=http://localhost:3000,http://localhost:3003
