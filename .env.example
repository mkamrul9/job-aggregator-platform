# ==============================================================================
# Seekers Job Aggregator Platform — Platform Orchestration Environment Example
# Copy to .env for local Docker Compose overrides. Never commit .env to source control.
# ==============================================================================

# --- Networking & Ports ---
GATEWAY_PORT=80
POSTGRES_PORT=5433
MONGO_PORT=27017
KAFKA_PORT=9092
ELASTICSEARCH_PORT=9200
USER_SERVICE_PORT=3002
RESUME_HTTP_PORT=8000
RESUME_GRPC_PORT=50051
INGESTION_PORT=5000
NOTIFICATION_PORT=4000
FRONTEND_NEXT_PORT=3003
FRONTEND_ADMIN_PORT=4200
PROMETHEUS_PORT=9090
GRAFANA_PORT=3004

# --- Database & Storage Credentials (Local Development Placeholders) ---
POSTGRES_USER=admin
POSTGRES_PASSWORD=password123
POSTGRES_DB=job_aggregator_users
MONGO_DB_NAME=job_platform
GRAFANA_ADMIN_PASSWORD=admin

# --- Internal Service URLs (Docker Network Defaults) ---
DATABASE_URL=postgresql://admin:password123@user-postgres:5432/job_aggregator_users?schema=public
RESUME_GRPC_URL=resume-grpc:50051
KAFKA_BROKER=kafka:9092
MONGO_URI=mongodb://job-mongo:27017
ES_NODE=http://elasticsearch:9200
SOCKET_CORS_ORIGIN=http://localhost:4200,http://localhost:3003

# --- Firebase Identity (Client Public Config & Dev Emulator) ---
# For local dev without live Firebase, use Firebase Auth Emulator (FIREBASE_AUTH_EMULATOR_HOST=localhost:9099)
NEXT_PUBLIC_FIREBASE_API_KEY=mock-api-key-placeholder
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=seekers-dev.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=seekers-dev
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
