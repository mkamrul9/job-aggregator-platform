# ==============================================================================
# service-resume (Python Resume Extractor) — Environment Configuration Example
# Copy to .env for local Python development.
# ==============================================================================

# --- HTTP Server (FastAPI / Uvicorn) ---
# Port for interactive OpenAPI docs and standalone parsing UI
PORT=8000
HOST=0.0.0.0

# --- gRPC Server ---
# Port for inter-service gRPC communication with service-user
GRPC_PORT=50051

# --- NLP Model & Skills Extraction ---
# spaCy linguistic pipeline model to load
SPACY_MODEL=en_core_web_sm

# --- Storage & Security ---
# Max resume upload limit in bytes (10MB default)
MAX_UPLOAD_SIZE_BYTES=10485760

# Local upload directory for received files
UPLOAD_DIR=./uploads

# Allowed CORS origins for web clients
CORS_ORIGINS=http://localhost:3000,http://localhost:3003
