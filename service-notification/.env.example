# ==============================================================================
# service-notification (Node.js Notification Service) — Environment Example
# Copy to .env for local development. Never commit real SMTP credentials.
# ==============================================================================

# --- HTTP & Socket.IO Server ---
PORT=4000
SOCKET_CORS_ORIGIN=http://localhost:4200,http://localhost:3003

# --- Kafka Event Broker ---
# Standalone local: localhost:9092
# Docker Compose:   kafka:9092
KAFKA_BROKER=localhost:9092
KAFKA_TOPIC=jobs.new
KAFKA_GROUP_ID=email-notification-group

# --- Email Delivery Configuration ---
# Mode 1: Local Development / Testing using Ethereal (or local capture mailbox like Mailpit)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=mock_user@ethereal.email
SMTP_PASS=mock_password
ALERT_FROM_EMAIL="Job Aggregator" <alerts@jobaggregator.local>

# Mode 2: Production Provider (e.g., AWS SES, SendGrid, Postmark)
# SMTP_HOST=email-smtp.us-east-1.amazonaws.com
# SMTP_PORT=587
# SMTP_USER=your_ses_smtp_username
# SMTP_PASS=your_ses_smtp_password
