// service-user/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CANDIDATE
  ADMIN
}

enum RemoteEligibility {
  FULLY_REMOTE
  HYBRID
  ON_SITE
  UNSPECIFIED
}

model User {
  id               String                   @id // Firebase UID
  email            String                   @unique
  emailVerified    Boolean                  @default(false)
  role             Role                     @default(CANDIDATE)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  profile          Profile?
  deletionRequests AccountDeletionRequest[]
  exportRequests   AccountExportRequest[]
  resumes          ResumeDocument[]
  parseResults     ResumeParseResult[]
  savedJobs        SavedJob[]
  savedSearches    SavedSearch[]
  applications     TrackedApplication[]
  supportReports   SupportReport[]
  alerts           AlertSubscription[]

  @@index([role])
}

model Profile {
  id                  String            @id @default(uuid())
  userId              String            @unique
  name                String            @default("")
  title               String?
  skills              String[]          @default([]) // Candidate-managed reviewed skills
  extractedSkills     String[]          @default([]) // Extracted skills from parser (isolated)
  resumeUrl           String?
  locations           String[]          @default([])
  remotePreference    RemoteEligibility @default(UNSPECIFIED)
  minSalary           Float?
  currency            String            @default("BDT")
  onboardingCompleted Boolean           @default(false)
  onboardingStep      Int               @default(0)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AccountDeletionRequest {
  id             String    @id @default(uuid())
  userId         String
  status         String    @default("PENDING") // PENDING, PROCESSING, COMPLETED, CANCELLED
  requestedAt    DateTime  @default(now())
  scheduledFor   DateTime  // 30-day grace period execution date
  idempotencyKey String?
  reason         String?
  executedAt     DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([userId, status])
}

model AccountExportRequest {
  id          String    @id @default(uuid())
  userId      String
  status      String    @default("READY") // PENDING, READY, FAILED
  format      String    @default("JSON")
  requestedAt DateTime  @default(now())
  completedAt DateTime?
  archiveUrl  String?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model ResumeDocument {
  id             String              @id @default(uuid())
  userId         String
  storageKey     String
  fileName       String
  fileSizeBytes  Int
  checksumSha256 String
  mimeType       String              @default("application/pdf")
  status         String              @default("UPLOADED") // UPLOADED, PROCESSING, PARSED, FAILED, DELETED, SUPERSEDED
  isActive       Boolean             @default(true)
  cleanupStatus  String              @default("CLEANED") // CLEANED, CLEANUP_PENDING, CLEANUP_FAILED
  deletedAt      DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  parseResults   ResumeParseResult[]

  @@index([userId, status])
  @@index([storageKey])
}

model ResumeParseResult {
  id               String          @id @default(uuid())
  documentId       String
  userId           String
  status           String          @default("QUEUED") // QUEUED, PROCESSING, COMPLETED, FAILED, CANCELLED
  extractedSkills  String[]        @default([])
  reviewedSkills   String[]        @default([])
  reviewedAt       DateTime?
  errorCode        String?
  errorMessage     String?
  processingTimeMs Int?
  attemptCount     Int             @default(0)
  maxAttempts      Int             @default(3)
  fenceToken       Int             @default(0)
  claimedBy        String?
  claimedUntil     DateTime?
  nextAttemptAt    DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  document         ResumeDocument  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([documentId])
}

model SavedJob {
  id              String   @id @default(uuid())
  userId          String
  jobId           String
  titleSnapshot   String
  companySnapshot String
  locationSnapshot String?
  jobUrlSnapshot  String?
  salarySnapshot  String?
  sourceSnapshot  String?
  statusAtSave    String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId, createdAt])
}

model SavedSearch {
  id                String   @id @default(uuid())
  userId            String
  name              String
  query             String?
  location          String?
  remoteEligibility String?
  seniority         String?
  jobType           String?
  minSalary         Float?
  currency          String   @default("BDT")
  payPeriod         String   @default("MONTHLY")
  sort              String   @default("date_desc")
  alertsEnabled     Boolean  @default(false)
  alertFrequency    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model TrackedApplication {
  id               String               @id @default(uuid())
  userId           String
  jobId            String
  titleSnapshot    String
  companySnapshot  String
  locationSnapshot String?
  jobUrlSnapshot   String?
  salarySnapshot   String?
  sourceSnapshot   String?
  status           String               @default("APPLIED") // APPLIED, INTERVIEWING, OFFERED, REJECTED, WITHDRAWN
  notes            String?
  version          Int                  @default(1)
  appliedAt        DateTime             @default(now())
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  history          ApplicationHistory[]

  @@unique([userId, jobId])
  @@index([userId, status])
  @@index([userId, updatedAt])
}

model ApplicationHistory {
  id            String             @id @default(uuid())
  applicationId String
  userId        String
  fromStatus    String?
  toStatus      String
  notesSnapshot String?
  changedAt     DateTime           @default(now())
  application   TrackedApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, changedAt])
  @@index([userId])
}

model SupportReport {
  id            String    @id @default(uuid())
  referenceNum  String    @unique
  userId        String?
  jobId         String?
  reportType    String    // EXPIRED_LISTING, BROKEN_LINK, INCORRECT_DATA, SPAM, OTHER
  description   String
  contactEmail  String?
  status        String    @default("RECEIVED") // RECEIVED, IN_REVIEW, RESOLVED, DISMISSED
  operatorNotes String?
  resolvedAt    DateTime?
  resolvedBy    String?
  ipHash        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([referenceNum])
}

model AlertSubscription {
  id        String   @id @default(uuid())
  userId    String
  query     String
  location  String?
  frequency String   @default("DAILY") // IMMEDIATE, DAILY, WEEKLY
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, active])
}
