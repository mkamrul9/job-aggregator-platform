// service-user/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CANDIDATE
  ADMIN
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String   // Will be populated by Firebase Auth uid later
  role          Role     @default(CANDIDATE)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  profile       Profile?
}

model Profile {
  id             String   @id @default(uuid())
  userId         String   @unique
  resumeUrl      String?
  extractedSkills String[] // PostgreSQL supports array types
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
