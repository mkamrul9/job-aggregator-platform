# ==============================================================================
# service-user (NestJS Identity & Profile API) — Environment Configuration Example
# Copy to .env for local development. Never commit real credentials.
# ==============================================================================

# --- HTTP Server ---
# Port for the NestJS HTTP application (default: 3000)
PORT=3000

# --- PostgreSQL Database (Required) ---
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public
# Standalone local: postgresql://admin:password123@localhost:5433/job_aggregator_users?schema=public
# Docker Compose:   postgresql://admin:password123@user-postgres:5432/job_aggregator_users?schema=public
DATABASE_URL=postgresql://admin:password123@localhost:5433/job_aggregator_users?schema=public

# --- Resume Extractor gRPC Integration (Adapter Dependency) ---
# Address of the Python gRPC resume parsing service
# Standalone local: localhost:50051
# Docker Compose:   resume-grpc:50051
RESUME_GRPC_URL=localhost:50051

# --- Firebase Identity Authentication ---
# Mode 1: Local Development with Firebase Emulator (Recommended for standalone testing)
# When set, Firebase Admin SDK talks to the local emulator without requiring live credentials.
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FIREBASE_PROJECT_ID=seekers-dev

# Mode 2: Live Firebase Project (Production / Staging)
# Path to the service account JSON key file (must remain outside version control).
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# --- Upload Storage Directory ---
# Local path for temporary resume uploads before gRPC dispatch
UPLOAD_DIR=./uploads
